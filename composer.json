{
    "name": "crystoline/xpsr-website",
    "description": "The XPSR website and documentation, built with XPSR and exported as static HTML",
    "type": "project",
    "license": "MIT",
    "homepage": "https://xpsr.crysto.name.ng",
    "authors": [
        {
            "name": "Adekunle",
            "email": "crystoline@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-phar": "*",
        "crystoline/xpsr-framework": "^0.5",
        "crystoline/xpsr-router-fastroute": "^0.5",
        "league/commonmark": "^2.10",
        "nyholm/psr7": "^1.8.2",
        "phiki/phiki": "^2.2",
        "symfony/process": "^7.4",
        "twig/twig": "^3.4"
    },
    "require-dev": {
        "filp/whoops": "^2.18.4",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "fetch": "@php xpsr site:fetch",
        "build": [
            "@php xpsr site:build",
            "npx --yes pagefind@1.5.2 --site build"
        ],
        "serve": "@php xpsr serve",
        "test": "phpunit --colors=always",
        "analyse": "phpstan analyse --no-progress",
        "style": "php-cs-fixer fix --dry-run --diff",
        "style:fix": "php-cs-fixer fix",
        "check": ["@test", "@analyse", "@style"]
    },
    "scripts-descriptions": {
        "fetch": "Fetch the documentation of every version from crystoline/xpsr.",
        "build": "Build the static site into build/, with search.",
        "serve": "Serve the site at http://localhost:3001, rendering pages on each request.",
        "check": "Run the tests, static analysis, and style checks."
    },
    "config": {
        "sort-packages": true,
        "process-timeout": 900
    }
}
