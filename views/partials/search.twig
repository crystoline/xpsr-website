{% import 'partials/icons.twig' as icon %}
<dialog class="search-dialog" id="search" aria-label="Search the documentation">
    <form class="search-form" method="dialog" role="search">
        {{ icon.search() }}
        <input type="search" name="q" placeholder="Search the docs" autocomplete="off" spellcheck="false" aria-label="Search the docs" aria-controls="search-results">
        <button class="search-close" type="button" data-search-close aria-label="Close the search">Esc</button>
    </form>
    <div class="search-results" id="search-results" role="listbox" aria-label="Results"></div>
    <p class="search-footer">
        {% if search_version %}Searching the {{ search_version == 'next' ? 'development' : search_version }} docs.{% endif %}
        <span><kbd>↑</kbd> <kbd>↓</kbd> to choose, <kbd>Enter</kbd> to open</span>
    </p>
</dialog>
