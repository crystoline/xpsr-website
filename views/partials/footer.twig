{% import 'partials/icons.twig' as icon %}
<footer class="site-footer">
    <div class="footer-inner">
        <div class="footer-brand">
            <a class="brand" href="/">{{ icon.logo('footer-logo') }}<span>{{ site.name }}</span></a>
            <p>A PHP framework built on PSR standards, with the parts you choose.</p>
        </div>
        <nav class="footer-links" aria-label="Footer">
            <div>
                <h2>Learn</h2>
                <a href="{{ docs_home }}">Documentation</a>
                {% for name, url in footer_guides %}<a href="{{ url }}">{{ name }}</a>{% endfor %}
            </div>
            <div>
                <h2>Project</h2>
                <a href="{{ site.github }}">GitHub</a>
                <a href="{{ site.packagist }}">Packagist</a>
                {% if changelog %}<a href="{{ changelog }}">Changelog</a>{% endif %}
                <a href="{{ site.github }}/issues">Issues</a>
            </div>
        </nav>
    </div>
    <div class="footer-note">
        <p>This site is built with XPSR{% if site.framework_version %} {{ site.framework_version }}{% endif %} and exported as static HTML. <a href="{{ site.website_github }}">See how</a>.</p>
        <p>Released under the MIT License.</p>
    </div>
</footer>
